		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    ЗачисленияВГруппу.Ссылка КАК Ссылка,
    ЗачисленияВГруппу.Дата КАК Дата,
    ЗачисленияВГруппу.СоставГруппы.(
        Студент КАК Студент,
        ВЫБОР
            КОГДА ЗачисленияВГруппу.Льготник = Истина
                ТОГДА 0
            ИНАЧЕ ЗачисленияВГруппу.СоставГруппы.СтоимостьОбучения
        КОНЕЦ КАК СтоимостьОбучения,
        Студент.СтатусОплаты КАК СтатусОплаты
    ) КАК СоставГруппы,
    ЗачисленияВГруппу.Группа.Курс КАК Курс
ИЗ
    Документ.ЗачисленияВГруппу КАК ЗачисленияВГруппу
ГДЕ
    МЕСЯЦ(ЗачисленияВГруппу.Дата) = &amp;Месяц</query>
