
&НаКлиенте
Процедура ГруппаПриИзменении(Элемент)
	ЗаполнитьСтоимостьНаСервере();	
КонецПроцедуры
	
&НаСервере
Процедура ЗаполнитьСтоимостьНаСервере()    
	Если Объект.Льготник = Истина Тогда
        
        Для Каждого Строка Из Объект.СоставГруппы Цикл
            Строка.СтоимостьОбучения = 0;
        КонецЦикла;
        
        Возврат;  
        
    КонецЕсли;
            
    Курс = Объект.Группа.Курс;
    БазоваяЦена = РаботаСРегистром.СтоимостьКурса(Объект.Дата, Курс);  
	КоличествоСтудентов = Объект.СоставГруппы.Количество();
	ЦенаСоСкидкой = РасчетыОбучения.РассчитатьСтоимостьСоСкидкой(Курс, КоличествоСтудентов, БазоваяЦена);
	
    
    // Заполняем ВСЕ строки табличной части
    Для Каждого Строка Из Объект.СоставГруппы Цикл
        Строка.СтоимостьОбучения = ЦенаСоСкидкой;
    КонецЦикла;    
КонецПроцедуры

&НаКлиенте
Процедура СоставГруппыСтудентПриИзменении(Элемент) 
	// Нужно для случая, когда группа выбрана раньше, чем заполнена таблица:
    // тогда "ГруппаПриИзменении" сработало на пустой таблице и цена не встала. 
	// При добавлении студента цена для каждого студента пересчитывается. 
	Если Не Объект.Льготник Тогда
        ЗаполнитьСтоимостьНаСервере(); 
    КонецЕсли; 
	
	ТекущиеДанные = Элементы.СоставГруппы.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ТекущиеДанные.Фото = ПолучитьНавСсылкуФото(ТекущиеДанные.Студент);
	
	КонецПроцедуры
	     
 
&НаСервереБезКонтекста
Функция ПолучитьНавСсылкуФото(СтудентСсылка)
    Если Не ЗначениеЗаполнено(СтудентСсылка) Тогда
        Возврат "";
    КонецЕсли;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   Студенты.Фото КАК Фото
        |ИЗ
        |   Справочник.Студенты КАК Студенты
        |ГДЕ
        |   Студенты.Ссылка = &Ссылка";
    Запрос.УстановитьПараметр("Ссылка", СтудентСсылка);
    
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Фото) Тогда
        Возврат ПолучитьНавигационнуюСсылку(Выборка.Фото, "Файл");
    КонецЕсли;
    Возврат "";
КонецФункции

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	 
	Для Каждого СтрокаТЧ Из Объект.СоставГруппы Цикл
        СтрокаТЧ.Фото = ПолучитьНавСсылкуФото(СтрокаТЧ.Студент);
	КонецЦикла;
	
	
	Если Объект.Льготник Тогда
        Для Каждого СтрокаТЧ Из Объект.СоставГруппы Цикл
            СтрокаТЧ.СтоимостьОбучения = 0;
        КонецЦикла;
    КонецЕсли;
    
    Элементы.СоставГруппыСтоимсотьОбучения.ТолькоПросмотр = Объект.Льготник;
КонецПроцедуры

&НаСервере
Процедура ЛьготникПриИзмененииНаСервере()
	Если Объект.Льготник Тогда
        Для Каждого СтрокаТЧ Из Объект.СоставГруппы Цикл
            СтрокаТЧ.СтоимостьОбучения = 0;
        КонецЦикла;
	КонецЕсли;
	Элементы.СоставГруппыСтоимсотьОбучения.ТолькоПросмотр = Объект.Льготник;
КонецПроцедуры

&НаКлиенте
Процедура ЛьготникПриИзменении(Элемент)
	ЛьготникПриИзмененииНаСервере();
КонецПроцедуры


&НаСервере
Процедура ОчиститьСписокНаСервере()
	Объект.СоставГруппы.Очистить();
КонецПроцедуры


&НаКлиенте
Процедура ОчиститьСписок(Команда)
	Ответ = Вопрос("Очистить список студентов? Все строки будут удалены.", 
                    РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, 
                    "Подтверждение");
    
    Если Ответ <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
    
  
    ОчиститьСписокНаСервере();
КонецПроцедуры
	
